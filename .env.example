# Documentation-safe local placeholders; replace the password for your environment.
POSTGRES_DB=country_explorer
POSTGRES_USER=country_explorer
POSTGRES_PASSWORD=change-me-local

# Required for country requests; empty permits startup and health checks.
REST_COUNTRIES_API_KEY=
REST_COUNTRIES_BASE_URL=https://api.restcountries.com/countries/v5

APP_PORT=8080
BACKEND_PORT=8081
FRONTEND_ORIGIN=http://localhost:8080
SESSION_COOKIE_SECURE=false

# Compose supplies DB_URL, DB_USERNAME and DB_PASSWORD to Spring Boot from
# POSTGRES_* above. For native backend development, export them as in README.md.
